APP_ENV=local
APP_KEY=replace_with_a_secret_key_at_least_32_characters

GROQ_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.3-70b-versatile
AI_REPORT_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=

AI_TIMEOUT_SEC=90
AI_SSL_VERIFY=0
AI_SSL_VERIFY_HOST=0
GOOGLE_CLIENT_ID=
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=../private_uploads
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_PREFIX=
UPLOAD_MAX_MB=5
UPLOAD_MAX_WIDTH=1920
UPLOAD_MAX_HEIGHT=1920
UPLOAD_JPEG_QUALITY=82
UPLOAD_REQUIRE_AV=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=BA Toolkit
