{
  "name": "CRM Foundation",
  "description": "Bo entity co ban cho he thong CRM.",
  "icon": "fa-database",
  "version": "1.0.0",
  "author": "Core Team",
  "tags": ["data", "crm"],
  "payload": {
    "entities": [
      {
        "name": "Company",
        "entity_type": "master",
        "description": "Thong tin doanh nghiep",
        "attributes": [
          { "name": "company_id", "data_type": "int", "is_primary_key": 1, "is_nullable": 0, "description": "Khoa chinh" },
          { "name": "company_name", "data_type": "string", "is_nullable": 0, "description": "Ten cong ty" },
          { "name": "industry", "data_type": "string", "is_nullable": 1, "description": "Nganh nghe" }
        ]
      },
      {
        "name": "Contact",
        "entity_type": "master",
        "description": "Nguoi lien he",
        "attributes": [
          { "name": "contact_id", "data_type": "int", "is_primary_key": 1, "is_nullable": 0, "description": "Khoa chinh" },
          { "name": "company_id", "data_type": "int", "is_foreign_key": 1, "reference_entity": "Company", "is_nullable": 0, "description": "Cong ty" },
          { "name": "full_name", "data_type": "string", "is_nullable": 0, "description": "Ho ten" },
          { "name": "email", "data_type": "string", "is_nullable": 1, "description": "Email" }
        ]
      },
      {
        "name": "Opportunity",
        "entity_type": "transaction",
        "description": "Co hoi kinh doanh",
        "attributes": [
          { "name": "opportunity_id", "data_type": "int", "is_primary_key": 1, "is_nullable": 0, "description": "Khoa chinh" },
          { "name": "contact_id", "data_type": "int", "is_foreign_key": 1, "reference_entity": "Contact", "is_nullable": 0, "description": "Lien he" },
          { "name": "title", "data_type": "string", "is_nullable": 0, "description": "Tieu de" },
          { "name": "stage", "data_type": "string", "is_nullable": 0, "description": "Giai doan" }
        ]
      }
    ],
    "relationships": [
      { "from": "Contact", "to": "Company", "type": "many-to-one", "fk": "company_id" },
      { "from": "Opportunity", "to": "Contact", "type": "many-to-one", "fk": "contact_id" }
    ]
  }
}
